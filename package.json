{
  "name": "isomorph",
  "version": "1.0.0",
  "description": "Isomorph — a formally specified DSL for software diagramming with bidirectional text-visual synchronisation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aurelian-th/isomorph.git"
  },
  "homepage": "https://aurelian-th.github.io/isomorph/",
  "keywords": [
    "dsl",
    "diagramming",
    "uml",
    "class-diagram",
    "bidirectional",
    "compiler",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
