    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.3",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@supabase/supabase-js": "^2.108.1",
    "codemirror": "^6.0.1",
    "fast-myers-diff": "^3.2.0",
    "lib0": "^0.2.117",
    "modern-gif": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replace-in-file": "^8.4.0",
    "y-codemirror.next": "^0.3.5",
